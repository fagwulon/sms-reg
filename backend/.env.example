# Copy to .env and fill in real values. NEVER commit .env to git.

APP_ENV=development
APP_NAME="SMS Summit 2026 Registration API"
API_V1_PREFIX=/api/v1

# PostgreSQL connection (Neon). Use the connection string from your Neon dashboard.
# Go to your Neon project -> Connection Details -> copy the connection string.
# Add +psycopg after postgresql for the driver prefix.
# Format: postgresql+psycopg://user:password@hostname/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign organizer JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://smssummit26.com

# Public URL of the frontend, used to build spouse invite links
APP_URL=http://localhost:5500

# Spouse invitation time-to-live in hours (contract default: 48)
INVITE_TTL_HOURS=48

# Max requests per minute per client on sensitive public endpoints (0 = off)
RATE_LIMIT_PER_MINUTE=20

# QR payload prefix, e.g. SMS26|SMS26-XXXX-0001
QR_PREFIX=SMS26
